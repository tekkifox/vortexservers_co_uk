{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/London",
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Docker base images",
      "separateMajorMinor": false,
      "automerge": false,
      "labels": ["dependencies", "toolchain"]
    },
    {
      "matchDepTypes": ["packageManager"],
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm package manager",
      "separateMajorMinor": false,
      "automerge": false,
      "labels": ["dependencies", "toolchain"]
    },
    {
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "React",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "matchPackageNames": ["@vercel/analytics", "@vercel/speed-insights"],
      "groupName": "Vercel analytics",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "matchPackageNames": ["next"],
      "groupName": "Next.js",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    }
  ]
}
